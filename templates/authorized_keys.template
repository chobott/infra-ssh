# SSH Authorized Keys Template
# Format: <key-type> <key> <comment> [options]

# Priklad s restrikcemi:
# from="192.168.1.0/24",no-port-forwarding,no-X11-forwarding,no-agent-forwarding ssh-ed25519 AAAA... user@firma.cz

# Produkcní´´ servery
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... admin+prod@firma.cz
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... deploy+prod@firma.cz

# Zalozní´´ pristup (pouze z management VLAN)
from="10.0.0.0/8",command="/usr/bin/tmux attach || /usr/bin/tmux" ssh-ed25519 AAAA... backup@firma.cz

# Interní´´ servery
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... admin+internal@firma.cz
